# ==============================================================================
# SALES DATA AGENT - ENVIRONMENT VARIABLES TEMPLATE (.env)
# ==============================================================================
# To activate this configuration:
# 1. Copy this template file as '.env': copy .env.template .env
# 2. Replace the placeholder values with your production credentials.
# ==============================================================================

# --- OpenAI API (Planning, Execution, Synthesis, and TruLens Evaluator) ---
OPENAI_API_KEY=sk-...

# LLM Model Configuration
LLM_MODEL=gpt-4o
REASONING_LLM_MODEL=gpt-4o

# --- Tavily Search API (Public Web Research) ---
TAVILY_API_KEY=tvly-...

# --- Snowflake Connection (Cortex Analyst and Cortex Search) ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
# Security Best Practice: Always use a least-privilege read-only role (never ACCOUNTADMIN)
SNOWFLAKE_ROLE=SALES_ANALYST_RO
SNOWFLAKE_WAREHOUSE=SALES_INTELLIGENCE_WH
SNOWFLAKE_DATABASE=SALES_INTELLIGENCE
SNOWFLAKE_SCHEMA=DATA

# --- TruLens Observability and OpenTelemetry Tracing ---
TRULENS_OTEL_TRACING=1
TRULENS_DATABASE_URL=sqlite:///default.sqlite
TRULENS_DASHBOARD_PORT=8001

